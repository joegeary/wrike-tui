{
  "name": "wrike-tui",
  "version": "0.2.0",
  "license": "MIT",
  "description": "A keyboard-first terminal client for Wrike",
  "type": "module",
  "private": true,
  "bin": {
    "wrike-tui": "dist/wrike-tui"
  },
  "scripts": {
    "dev": "bun run src/main.tsx",
    "build": "bun scripts/build.ts",
    "test": "bun test ./test",
    "e2e": "bun run build && bun test ./e2e",
    "typecheck": "tsc --noEmit",
    "screenshots": "bun scripts/screenshots/main.ts"
  },
  "dependencies": {
    "@mixmark-io/domino": "2.2.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentui/core": "0.8.4",
    "@opentui/react": "0.8.4",
    "marked": "18.2.0",
    "react": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
